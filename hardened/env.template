# Hardened local OmniRoute config (template, contains NO secrets).
# setup.sh copies this to $DATA_DIR/.env and fills the CHANGEME_* values
# with freshly generated random ones. Never commit the generated file.

# --- Network: loopback only, API key required ---
OMNIROUTE_SERVER_HOST=127.0.0.1
REQUIRE_API_KEY=true
PORT=20128

# --- Secrets (generated by setup.sh) ---
JWT_SECRET=CHANGEME_JWT
API_KEY_SECRET=CHANGEME_API
STORAGE_ENCRYPTION_KEY=CHANGEME_STORAGE
INITIAL_PASSWORD=CHANGEME_PASSWORD

# --- Privacy: do not keep prompts or conversations ---
OMNIROUTE_DISABLE_CONVERSATION_TRACKING=1
ENABLE_REQUEST_LOGS=false

# --- Redaction (opt-in upstream, switched on here) ---
PII_REDACTION_ENABLED=true
CREDENTIAL_REDACTION_ENABLED=true

# --- Off by default upstream; pinned off here so nothing flips them on ---
CLOUD_URL=
FREE_PROXY_AUTO_SYNC_ENABLED=false
